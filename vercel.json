{
 "headers": [
  {
   "source": "/pages/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  },
  {
   "source": "/cv/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  },
  {
   "source": "/admin/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-cache"
    },
    {
     "key": "X-Robots-Tag",
     "value": "noindex, nofollow"
    },
    {
     "key": "X-Frame-Options",
     "value": "DENY"
    }
   ]
  },
  {
   "source": "/media.js",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-cache"
    }
   ]
  }
 ]
}